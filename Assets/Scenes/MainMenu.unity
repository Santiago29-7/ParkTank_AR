  m_text: "<b><color=#588bae>EQUIPO DE DESARROLLO</color></b>\r\n\r\n<b>Julian Jose
    Rodriguez Perilla</b>\r\n<b>Johnny Santiago Perilla Guerrero</b>\r\n\r\n<size=85%><i>Desarrollo
    principal y dise\xF1o de AR</i></size>\r\n\r\n<b><color=#77B255>PROYECTO ACAD\xC9MICO</color></b>\n\n<b>Plataformas
    de Computaci\xF3n</b>\n\r\n<b>Ingenier\xEDa de Sistemas</b>\n\r\n<b>Fundaci\xF3n
    Universitaria Juan de Castellanos</b>\r\n<size=75%>Tunja, Colombia</size>\r\n\r\n----------------------------------\r\n\r\n<b><color=#E6B800>EQUIPO
    DE DOCUMENTACI\xD3N</color></b>\r\n\r\n<b>Bradle Heziel Ake Canul</b>\r\n<b>Navarrete
    Pacheco Gael Alberto</b>\n<b>Castillo Hernandez Brandon Alexis</b>\r\n<b>Diego
    Murgu\xEDa Rosaldo</b>\n<b>Chi Chan Jonathan Isai</b>\r\n<b>Carlos Daniel Que
    P\xE9rez</b>\r\n\r\n<size=85%><i>Gesti\xF3n de documentaci\xF3n y soporte metodol\xF3gico</i></size>\n\r\n<b>Universidad
    del Caribe</b>\r\n<size=75%>M\xE9xico</size>\r\n\r\n----------------------------------\r\n\r\n<size=75%>Colaboraci\xF3n
    Internacional \u2022 2026</size>"
