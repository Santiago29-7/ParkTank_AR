  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022 Mantente alerta de tu entorno en todo momento. No mires solo la
    pantalla.\n\n\u2022 Evita caminar hacia atr\xE1s mientras juegas para evitar
    tropiezos.\n\n\u2022 Presta atenci\xF3n a peatones, bicicletas, \xE1rboles y
    desniveles del terreno.\n\n\u2022 SI ERES MENOR DE EDAD, JUEGA SIEMPRE BAJO LA
    SUPERVISI\xD3N DE UN ADULTO.\n\n\u2022 Juega en \xE1reas abiertas y seguras."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: cf7c31399fe0fd040984cf7002fbdbc2, type: 2}
  m_sharedMaterial: {fileID: -5088207211183604795, guid: cf7c31399fe0fd040984cf7002fbdbc2, type: 2}
